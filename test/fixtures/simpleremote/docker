#!/usr/bin/env bash
set -Eeuo pipefail

: "${VIMRC_TEST_REMOTE_AGENT:?}"
: "${VIMRC_TEST_REMOTE_TARGET:?}"
: "${VIMRC_TEST_DOCKER_LOG:?}"

expected="exec \"\$HOME\"/'.cache/vimrc/agent dir/simpleremote-agent.sh'"
if [[ $# -ne 6 \
      || $1 != exec \
      || $2 != -i \
      || $3 != "$VIMRC_TEST_REMOTE_TARGET" \
      || $4 != sh \
      || $5 != -lc \
      || $6 != "$expected" ]]; then
  printf 'unexpected docker invocation:' >&2
  printf ' <%s>' "$@" >&2
  printf '\n' >&2
  exit 64
fi

{
  printf 'argc=%s\n' "$#"
  for argument do
    printf 'arg=%s\n' "$argument"
  done
} >"$VIMRC_TEST_DOCKER_LOG"

exec sh "$VIMRC_TEST_REMOTE_AGENT"
